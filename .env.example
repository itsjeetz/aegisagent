# AegisAgent Environment Variables
# Copy this file to .env and customize as needed.

# Anthropic API Key for LLM Judge, Victim Agent, and Red Team
ANTHROPIC_API_KEY=

# LLM Models
JUDGE_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-5

# Optional Hugging Face classifier ID (e.g. meta-llama/Prompt-Guard-86M or protectai/deberta-v3-base-prompt-injection-v2)
HF_CLASSIFIER_ID=

# Observability (1 = store raw content in audit_log; 0 = store only SHA-256 and redacted excerpts)
STORE_CONTENT=0

# Server configuration
HOST=0.0.0.0
PORT=8000
